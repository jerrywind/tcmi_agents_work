# server 配置示例（合并 rrserver 中继凭证 + 后续 diagnose 设置）
#
# 复制为 server.toml 并修改：[[tunnels]] 的 name/token 需与家庭端 llm_server
# 的 rrclient.name/token 一致；external_ws_base 为对外 WS 注册基址
# （部署在 deploy 下时填 https://<域名>/rr）。

# 对外 WebSocket 注册基址（家庭端 llm_server 据此拼接 /ws/<name>）
external_ws_base = "https://your-domain.example.com/rr"

# 隧道凭证表：每条 [[tunnels]] 对应一个家庭端注册名
[[tunnels]]
name = "home"
token = "change-me-strong-token"

[[tunnels]]
name = "home-llm"
token = "another-strong-token"

# 可选：远端能力公告（阶段 A 占位）
# [[skills]]
# name = "acme"
# cooldown_secs = 0
# cost = 0
# required_state = "idle"
