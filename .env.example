# 复制为 .env 后填写（docker compose 会自动读取）

# 是否启用可选 Redis（会话共享，支持多 worker）。取值：memory | redis
TCM_STORE=memory

# Redis 连接串（仅当 TCM_STORE=redis 时生效）
TCM_REDIS_URL=redis://redis:6379/0

# LLM 配置（留空则全程 mock 降级，仍可演示完整流程）
TCM_LLM_API_KEY=
TCM_LLM_BASE_URL=https://api.openai.com/v1
TCM_LLM_TEXT_MODEL=gpt-4o-mini
TCM_LLM_VISION_MODEL=gpt-4o

# 跨域允许来源（逗号分隔；生产请填前端域名，勿用 *）
TCM_CORS_ORIGINS=*
