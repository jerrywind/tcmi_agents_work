# llm_server v2 运行参数示例（复制为 .env 后由 docker compose 读取）
# 模型由 LM Studio 提供，无需下载任何 GGUF 权重。

# ---- 服务监听 ----
LLM_HOST=0.0.0.0
LLM_PORT=8000

# ---- LM Studio 上游 ----
# 本地直跑 Python：保持 http://localhost:11223/v1
# Docker 容器内访问宿主机：http://host.docker.internal:11223/v1
LMSTUDIO_BASE_URL=http://localhost:11223/v1
# LM Studio → Developer → Server Settings 中的 API Key（关闭校验则任意非空串）
LMSTUDIO_API_KEY=sk-noauth
# 默认模型（LM Studio 中加载的模型 id，如 google/gemma-4-12b-qat）
DEFAULT_MODEL=google/gemma-4-12b-qat
# 上游请求超时（秒）
REQUEST_TIMEOUT=180

# ---- Prompt 优化 ----
# 是否对 /v1/chat/completions 做上下文优化（合并/压缩/预算裁剪）
ENABLE_PROMPT_OPTIMIZE=true
# 优化后消息总预算（字符数，约 6K~8K token）
PROMPT_MAX_CHARS=12000
# 未显式提供 system 时注入的默认提示
PROMPT_SYSTEM_BRIEF=你是风蓝科技智能中医助手。请使用中文回答，尽量简洁、结构化，不做超出资料范围的诊断承诺。

# ---- Agent 循环 ----
# 单次 agent 最大工具调用轮数
AGENT_MAX_ROUNDS=8
# 工具结果回填给模型的最大长度（字符）
AGENT_MAX_TOOL_OUTPUT_CHARS=3000

# ---- MCP ----
# 是否连接外部 MCP Server 并纳入其工具
ENABLE_MCP=true
# 外部 MCP Server 列表（JSON 数组，Streamable HTTP）
# 工具会以 {name}_{tool} 命名注入 agent 工具集
MCP_CLIENTS=[]
# MCP_CLIENTS 示例：
# MCP_CLIENTS=[{"name":"kb","url":"http://127.0.0.1:9000/mcp","headers":{"Authorization":"Bearer sk-xxx"}}]
