# llm_server 运行参数示例（复制到 .env 后由 docker compose --profile llm 读取）
# 注意：文本服务(llm_server)与视觉服务(llm_vision)共用本文件，
# 但各自通过 compose 的 MODEL_PATH 覆盖指向不同权重。

# 模型与可选 mmproj 权重（GGUF）所在目录，需把下载好的文件放到该宿主机目录
MODEL_DIR=./models
# 文本模型（llm_server）—— 如 qwen3.6-9B
MODEL_PATH=/models/qwen3.6-9B.gguf
# 视觉模型（llm_vision）—— 如 Qwen3-VL，原生多模态，无需 mmproj
# MODEL_PATH_VISION=/models/qwen3-vl.gguf
# mmproj 为可选项：纯文本模型可不挂；Qwen3-VL 等原生多模态模型也不需要
MMPROJ_PATH=/models/mmproj.gguf

# 服务监听
LLM_HOST=0.0.0.0
LLM_PORT=8000

# 推理参数
CTX_SIZE=8192
# GPU 层数：CPU 填 0；有 CUDA 的机器可填 20~35 以加速（需 server-cuda 镜像）
GPU_LAYERS=0

# OpenAI 兼容 API 的密钥（llama.cpp 仅做校验，任意非空串即可；后端用同一值）
API_KEY=sk-noauth
