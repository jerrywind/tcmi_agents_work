# llm_server v2 运行参数示例（复制为 .env 后由 docker compose 读取）
# 模型由 LM Studio 提供，无需下载任何 GGUF 权重。

# ---- 服务监听 ----
LLM_HOST=0.0.0.0
LLM_PORT=8000

# ---- LM Studio 上游 ----
# example CURL :
#   curl http://localhost:11223/api/v1/chat -H "Content-Type: application/json" -d '{"model": "google/gemma-4-12b-qat", "system_prompt": "You answer only in rhymes.","input": "What is your favorite color?"}'
# 本地直跑 Python：保持 http://localhost:11223/v1
# Docker 容器内访问宿主机：http://host.docker.internal:11223/v1
LMSTUDIO_BASE_URL=http://localhost:11223/v1
# LM Studio → Developer → Server Settings 中的 API Key（关闭校验则任意非空串）
LMSTUDIO_API_KEY=sk-xxx   # 澶嶅埗鏈枃浠朵负 .env 鍚庡～鍏ョ湡瀹?Key锛?env 宸茶 git 蹇界暐锛屽垏鍕挎妸鐪熷疄 Key 鎻愪氦杩涗粨搴擄級
# 默认模型（LM Studio 中加载的模型 id，如 google/gemma-4-12b-qat）
DEFAULT_MODEL=google/gemma-4-12b-qat
# 上游请求超时（秒）
REQUEST_TIMEOUT=180

# ---- Prompt 优化 ----
# 是否对 /v1/chat/completions 做上下文优化（合并/压缩/预算裁剪）
ENABLE_PROMPT_OPTIMIZE=true
# 优化后消息总预算（字符数，约 6K~8K token）
PROMPT_MAX_CHARS=12000
# 未显式提供 system 时注入的默认提示
PROMPT_SYSTEM_BRIEF=你是风蓝科技智能中医助手。请使用中文回答，尽量简洁、结构化，不做超出资料范围的诊断承诺。

# ---- Agent 循环 ----
# 单次 agent 最大工具调用轮数
AGENT_MAX_ROUNDS=8
# 工具结果回填给模型的最大长度（字符）
AGENT_MAX_TOOL_OUTPUT_CHARS=3000

# ---- MCP ----
# 是否连接外部 MCP Server 并纳入其工具
ENABLE_MCP=true
# 外部 MCP Server 列表（JSON 数组，Streamable HTTP）
# 工具会以 {name}_{tool} 命名注入 agent 工具集
MCP_CLIENTS=[]
# MCP_CLIENTS 示例：
# MCP_CLIENTS=[{"name":"kb","url":"http://127.0.0.1:9000/mcp","headers":{"Authorization":"Bearer sk-xxx"}}]

# ---- rrserver 注册与心跳 ----
# 留空即不启用。启用后本服务启动时会主动向 rrserver 注册并换取一个独立 hash code，
# 之后每 30 分钟上报一次心跳；rrserver 40 分钟没收到心跳会主动探活，
# 探活失败则记录日志并关闭该注册维护（本服务下次心跳收到 404 后会自动重新注册）。
RR_SERVER_BASE=                 # 如 https://<域名>/rr
RR_SERVICE_NAME=llm-server      # 须与 rrserver 配置 [[tunnels]] 的 name 一致
RR_SERVICE_TOKEN=               # 与 rrserver 对应隧道的 token 一致
# 本服务可被 rrserver 直达的基址（同一 docker 网络）；留空则按 ws 反向隧道注册
RR_SERVICE_ENDPOINT=            # 如 http://llm_server:8000
# 心跳周期不用配：由 rrserver 注册响应下发（默认 30 分钟）
RR_TIMEOUT_SECS=10              # 注册/心跳请求超时（秒）
RR_RETRY_INTERVAL_SECS=30       # 注册或心跳失败后的退避重试间隔（秒）
